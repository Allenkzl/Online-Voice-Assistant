{
  "硬件": "Reachy Mini (USB声卡 + 共享dsnoop/dmix)",
  "input_device": "reachymini_audio_src",
  "output_device": "reachymini_audio_sink",
  "channel": 0,
  "wake_model_dir": "models",
  "asr_model_dir": "models/asr_sense_voice_zh_en_int8",
  "asr_说明": "本地中英双语识别: SenseVoice int8 (推荐, 中/英/粤/日/韩, 带标点与语种标签)。回退中文模型: models/asr_paraformer_zh_int8 (更准) / models/asr_paraformer_zh_small (更快)",
  "threshold": 0.3,
  "hits": 4,
  "cooldown": 3.0,
  "dialogue": true,
  "engine": "pipeline",
  "engine_说明": "pipeline=本地ASR→千问LLM→千问TTS(半在线) / e2e=录音直发 GLM-4-Voice 端到端(需 ZHIPUAI_API_KEY)",
  "ack_before_reply": true,
  "glm_voice_model": "glm-4-voice",
  "glm_voice_persona": "",
  "glm_voice_timeout_s": 10.0,
  "end_silence_s": 1.2,
  "max_question_s": 15.0,
  "listen_delay_s": 0.6,
  "barge_in": true,
  "barge_in_threshold": 0.3,
  "barge_in_hits": 4,
  "barge_in_max_command_s": 6.0,
  "barge_in_listen_delay_s": 0.2,
  "barge_in_resume_rewind_s": 0.6,
  "barge_in_log_interval_s": 2.0,
  "speaking_state_file": "/tmp/ova_speaking.state",
  "glm_voice_target_rms": 0.09,
  "glm_voice_pcm_rate": 24000
}
